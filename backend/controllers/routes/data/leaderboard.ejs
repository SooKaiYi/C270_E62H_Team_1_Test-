<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/styles.css">
    <title>Bike App - Distance Leaderboard</title>
</head>
<body class="bg-city">
    <div class="glass-container leaderboard-container">
        <div class="card leaderboard-card">
            <div class="leaderboard-header">
                <div>
                    <p class="eyebrow">Distance Tracker</p>
                    <h2>Ride Leaderboard</h2>
                    <p class="leaderboard-subtitle">Compare your progress with the whole community or just your circle.</p>
                </div>
                <a class="btn-orange small-btn leaderboard-link" href="/tracker">Back to tracker</a>
            </div>

            <div class="leaderboard-grid">
                <section class="leaderboard-panel">
                    <h3>🌍 Global leaderboard</h3>
                    <ol class="leaderboard-list">
                        <% leaderboard.global.forEach((entry, index) => { %>
                            <li class="leaderboard_item <%= entry.name === user.name ? 'highlight' : '' %>">
                                <span class="rank"><%= index + 1 %></span>
                                <div class="entry-info">
                                    <strong><%= entry.name %></strong>
                                    <small><%= entry.city %></small>
                                </div>
                                <span class="distance"><%= entry.distance.toFixed(1) %> km</span>
                            </li>
                        <% }) %>
                    </ol>
                </section>

                <section class="leaderboard-panel">
                    <h3>👥 Friends leaderboard</h3>
                    <ol class="leaderboard-list">
                        <% leaderboard.friends.forEach((entry, index) => { %>
                            <li class="leaderboard_item <%= entry.name === user.name ? 'highlight' : '' %>">
                                <span class="rank"><%= index + 1 %></span>
                                <div class="entry-info">
                                    <strong><%= entry.name %></strong>
                                    <small><%= entry.city %></small>
                                </div>
                                <span class="distance"><%= entry.distance.toFixed(1) %> km</span>
                            </li>
                        <% }) %>
                    </ol>
                </section>
            </div>
        </div>
    </div>
</body>
</html>
