<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/styles.css">
    <title>Bike App - Track Ride</title>
</head>
<body class="bg-city">
    <div class="glass-container">
        <div class="card">
            <h2>Live Ride Tracker</h2>
            <div class="stats-grid">
                <div class="stat-box">
                    <p>Distance</p>
                    <h3 id="distance">0.00</h3><span>km</span>
                </div>
                <div class="stat-box">
                    <p>Calories</p>
                    <h3 id="calories">0</h3><span>kcal</span>
                </div>
            </div>

            <div class="goal-card">
                <label for="weeklyGoalInput">Weekly calorie goal</label>
                <div class="goal-controls">
                    <input id="weeklyGoalInput" type="number" min="100" step="50" placeholder="15000">
                    <button id="saveGoalBtn" class="btn-orange small-btn" type="button">Set Goal</button>
                </div>
                <div class="goal-progress">
                    <div id="goalProgressFill" class="goal-progress-fill"></div>
                </div>
                <p id="goalStatus" class="goal-status">No goal set yet.</p>
            </div>

            <p id="status">Tracking Location...</p>
            <button class="btn-orange" onclick="location.href='/leaderboard'">View Leaderboard</button>
            <button class="btn-orange" onclick="location.href='/'" style="margin-top: 0.75rem;">End Ride</button>
        </div>
    </div>

    <script>
        let totalDistance = 0;
        let lastCoords = null;
        let weeklyCalories = 0;
        let weeklyGoal = null;
        let weekKey = getWeekKey(new Date());

        const storageKey = 'bike-tracker-weekly-goal';
        const goalInput = document.getElementById('weeklyGoalInput');
        const saveGoalBtn = document.getElementById('saveGoalBtn');
        const progressFill = document.getElementById('goalProgressFill');
        const goalStatus = document.getElementById('goalStatus');

        function calculateDistance(lat1, lon1, lat2, lon2) {
            const R = 6371;
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;
            const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLon/2) * Math.sin(dLon/2);
            return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
        }

        function getWeekKey(date) {
            const weekDate = new Date(date);
            const day = weekDate.getDay() || 7;
            weekDate.setHours(0, 0, 0, 0);
            weekDate.setDate(weekDate.getDate() - day + 1);
            return weekDate.toISOString().slice(0, 10);
        }

        function saveWeeklyState() {
            localStorage.setItem(storageKey, JSON.stringify({
                weekKey,
                goal: weeklyGoal,
                burned: weeklyCalories
            }));
        }

        function updateGoalUI() {
            if (!weeklyGoal || weeklyGoal <= 0) {
                progressFill.style.width = '0%';
                progressFill.textContent = '';
                goalStatus.textContent = 'No weekly goal set yet.';
                return;
            }

            const percent = Math.min(100, Math.round((weeklyCalories / weeklyGoal) * 100));
            progressFill.style.width = `${percent}%`;
            progressFill.textContent = `${percent}%`;

            if (weeklyCalories >= weeklyGoal) {
                goalStatus.textContent = 'Weekly goal reached! Great job.';
            } else {
                const remaining = Math.max(0, weeklyGoal - weeklyCalories);
                goalStatus.textContent = `${weeklyCalories} / ${weeklyGoal} kcal burned. ${remaining} kcal left this week.`;
            }
        }

        function loadWeeklyState() {
            try {
                const saved = JSON.parse(localStorage.getItem(storageKey));
                if (saved && saved.weekKey === weekKey) {
                    weeklyGoal = Number(saved.goal) || null;
                    weeklyCalories = Number(saved.burned) || 0;
                } else {
                    weeklyGoal = Number(saved?.goal) || null;
                    weeklyCalories = 0;
                    weekKey = getWeekKey(new Date());
                }
            } catch (error) {
                weeklyGoal = null;
                weeklyCalories = 0;
            }

            if (weeklyGoal) {
                goalInput.value = weeklyGoal;
            }

            updateGoalUI();
            saveWeeklyState();
        }

        function setWeeklyGoal() {
            const parsedGoal = Number(goalInput.value);
            if (!Number.isFinite(parsedGoal) || parsedGoal <= 0) {
                goalStatus.textContent = 'Please enter a valid calorie goal.';
                return;
            }

            weeklyGoal = Math.round(parsedGoal);
            saveWeeklyState();
            updateGoalUI();
            goalInput.value = '';
        }

        saveGoalBtn.addEventListener('click', setWeeklyGoal);
        goalInput.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') {
                event.preventDefault();
                setWeeklyGoal();
            }
        });

        loadWeeklyState();

        navigator.geolocation.watchPosition((position) => {
            const { latitude, longitude } = position.coords;
            if (lastCoords) {
                const dist = calculateDistance(lastCoords.lat, lastCoords.lng, latitude, longitude);
                if (dist > 0.001) {
                    totalDistance += dist;
                    weeklyCalories += Math.round(dist * 30);
                    document.getElementById('distance').innerText = totalDistance.toFixed(2);
                    document.getElementById('calories').innerText = Math.floor(totalDistance * 30);
                    saveWeeklyState();
                    updateGoalUI();
                }
            }
            lastCoords = { lat: latitude, lng: longitude };
            document.getElementById('status').innerText = 'Signal: Active';
        }, (err) => {
            document.getElementById('status').innerText = 'Error: Enable GPS';
        }, { enableHighAccuracy: true });
    </script>
</body>
</html>
