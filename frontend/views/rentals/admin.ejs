<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/styles/home.css">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">

        <div class="container">

            <a class="navbar-brand fw-bold fs-3" href="/home">

                🚲 CityScoot

            </a>

            <button
                class="navbar-toggler"
                data-bs-toggle="collapse"
                data-bs-target="#navbar">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="navbar">

                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/admin/dashboard">
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/bikes/admin">
                            Bikes
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/wallet/admin">
                            Wallet
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link active" href="/rentals/admin">
                            Rentals
                        </a>
                    </li>

                </ul>

                <a
                    href="/logout"
                    class="btn btn-light">

                    Logout

                </a>

            </div>

        </div>

    </nav>

    <!-- ================= CONTENT ================= -->

    <div class="container mt-5">

        <h2 class="mb-4">

            <i class="fa-solid fa-list-check"></i>

            Rental Management

        </h2>

        <% if(rentals.length===0){ %>

            <div class="alert alert-info">

                No rental records found.

            </div>

        <% } else { %>

            <table class="table table-bordered table-hover shadow">

                <thead class="table-primary">

                    <tr>

                        <th>ID</th>
                        <th>User</th>
                        <th>Bike</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Rented At</th>
                        <th>Returned At</th>
                        <th width="250">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    <% rentals.forEach(rental => { %>

                        <tr>

                            <td>

                                <%= rental.id %>

                            </td>

                            <td>

                                <strong>

                                    <%= rental.userName %>

                                </strong>

                                <br>

                                <small>

                                    User ID:
                                    <%= rental.userId %>

                                </small>

                            </td>

                            <td>

                                <%= rental.bikeName %>

                            </td>

                            <td>

                                $<%= Number(rental.amount).toFixed(2) %>

                            </td>

                            <td>

                                <% if(rental.status==="Active"){ %>

                                    <span class="badge bg-success">

                                        Active

                                    </span>

                                <% } else { %>

                                    <span class="badge bg-secondary">

                                        Returned

                                    </span>

                                <% } %>

                            </td>

                            <td>

                                <%= new Date(rental.rentedAt).toLocaleString() %>

                            </td>

                            <td>

                                <% if(rental.returnedAt){ %>

                                    <%= new Date(rental.returnedAt).toLocaleString() %>

                                <% } else { %>

                                    -

                                <% } %>

                            </td>

                            <td>

                                <% if(rental.status==="Active"){ %>

                                    <form
                                        action="/rentals/return/<%= rental.id %>"
                                        method="POST"
                                        style="display:inline;">

                                        <button
                                            class="btn btn-warning btn-sm">

                                            Return

                                        </button>

                                    </form>

                                <% } %>

                                <form
                                    action="/rentals/delete/<%= rental.id %>"
                                    method="POST"
                                    style="display:inline;">

                                    <button
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Delete this rental record?')">

                                        Delete

                                    </button>

                                </form>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        <% } %>

    </div>

    <footer class="bg-primary text-white mt-5">

        <div class="container text-center p-4">

            <h4>

                CityScoot Bicycle Rental

            </h4>

            <p>

                Admin Rental Management Panel

            </p>

        </div>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>