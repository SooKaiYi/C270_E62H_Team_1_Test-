<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Repair Admin</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/styles/bikeRepairFeature.css">
</head>

<body>

<div class="container mt-5">

    <h1 class="mb-4">Bike Repair Reports</h1>

    <a href="/repair" class="btn btn-secondary mb-3">
        Back to Repair Form
    </a>

    <% if (reports.length === 0) { %>

        <div class="alert alert-info">
            No repair reports found.
        </div>

    <% } else { %>

        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">

                    <tr>
                        <th>ID</th>
                        <th>Station</th>
                        <th>Bike ID</th>
                        <th>Issue</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Update</th>
                    </tr>

                </thead>

                <tbody>

                    <% reports.forEach(report => { %>

                        <tr>

                            <td><%= report.id %></td>
                            <td><%= report.bikeStation %></td>
                            <td><%= report.bikeID %></td>
                            <td><%= report.issueType %></td>
                            <td><%= report.description %></td>
                            <td><%= report.date %></td>
                            <td><%= report.status %></td>

                            <td>

                                <form
                                    action="/repair/admin/update/<%= report.id %>"
                                    method="POST"
                                >

                                    <select
                                        name="status"
                                        class="form-select mb-2"
                                    >
                                        <option
                                            value="Pending"
                                            <%= report.status === "Pending" ? "selected" : "" %>
                                        >
                                            Pending
                                        </option>

                                        <option
                                            value="Resolved"
                                            <%= report.status === "Resolved" ? "selected" : "" %>
                                        >
                                            Resolved
                                        </option>
                                    </select>

                                    <button
                                        type="submit"
                                        class="btn btn-primary btn-sm"
                                    >
                                        Update
                                    </button>

                                </form>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    <% } %>

</div>

</body>
</html>