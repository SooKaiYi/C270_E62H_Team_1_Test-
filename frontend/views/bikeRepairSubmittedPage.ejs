<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Repair Request Submitted</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/styles/bikeRepairFeature.css" />
  </head>

  <body>
    <div class="container mt-5">
      <div class="card shadow p-4">
        <h1 class="text-success">Repair Request Submitted</h1>

        <p>Your repair report has been recorded successfully.</p>

        <hr />

        <p><strong>Station:</strong> <%= report.bikeStation %></p>
        <p><strong>Bike ID:</strong> <%= report.bikeID %></p>
        <p><strong>Issue:</strong> <%= report.issueType %></p>
        <p><strong>Description:</strong> <%= report.description %></p>
        <p><strong>Status:</strong> <%= report.status %></p>
        <p><strong>Date:</strong> <%= report.date %></p>

        <a href="/repair" class="btn btn-primary"> Submit Another Report </a>

        <a href="/home" class="btn btn-secondary"> Back to Home </a>
      </div>
    </div>
  </body>
</html>
