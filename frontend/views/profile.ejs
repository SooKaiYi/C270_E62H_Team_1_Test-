<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Profile - CityScoot</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/styles/home.css" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>

  <body>
    <!-- ================= NAVBAR ================= -->

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
      <div class="container">
        <a class="navbar-brand fw-bold fs-3" href="/"> &#128692; CityScoot </a>

        <button
          class="navbar-toggler"
          data-bs-toggle="collapse"
          data-bs-target="#navbar"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbar">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <a class="nav-link" href="/home">Home</a>
            </li>

            <li class="nav-item">
              <a
                class="nav-link"
                href="/bikes"
                title="Available bicycles and prices"
              >
                Bikes
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/map" title="Track your ride distance">
                Map
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/wallet" title="Manage your wallet">
                Wallet
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/rentals" title="View rental history">
                Rentals
              </a>
            </li>

            <li class="nav-item">
              <a
                class="nav-link"
                href="/rewards"
                title="Points, referrals and redemptions"
              >
                Rewards
              </a>
            </li>
          </ul>

          <!-- PROFILE -->

          <div class="dropdown">
            <button
              class="btn btn-light dropdown-toggle"
              type="button"
              data-bs-toggle="dropdown"
            >
              <i class="fa-solid fa-user"></i>

              <%= user.name %>
            </button>

            <ul
              class="dropdown-menu dropdown-menu-end p-3"
              style="width: 250px"
            >
              <a href="/profile" class="text-decoration-none text-dark">
                <h5 class="mb-0"><%= user.name %></h5>
              </a>

              <p class="text-muted mb-1"><%= user.email %></p>

              <span class="badge bg-success mb-3"> <%= user.role %> </span>

              <hr />

              <a class="dropdown-item" href="/profile">
                <i class="fa-solid fa-id-badge"></i>
                Profile
              </a>

              <a class="dropdown-item" href="/wallet">
                <i class="fa-solid fa-wallet"></i>
                Wallet
              </a>

              <a class="dropdown-item" href="/rewards">
                <i class="fa-solid fa-star"></i>
                Rewards
              </a>

              <% if(user.role=="Admin"){ %>

              <hr />

              <a class="dropdown-item" href="/admin/dashboard">
                <i class="fa-solid fa-user-shield"></i>

                Admin Dashboard
              </a>

              <% } %>

              <hr />

              <a class="dropdown-item" href="/logout"> Logout </a>
            </ul>
          </div>
        </div>
      </div>
    </nav>

    <!-- ================= PROFILE CONTENT ================= -->

    <div class="container mt-5 mb-5" style="max-width: 700px">
      <a
        href="/home"
        class="text-decoration-none text-muted small mb-3 d-inline-block"
      >
        <i class="fa-solid fa-arrow-left"></i> Back to Home
      </a>

      <!-- AVATAR + NAME CARD -->
      <div class="card shadow mb-4">
        <div class="card-body p-4 text-center">
          <div
            class="mx-auto mb-3 d-flex align-items-center justify-content-center"
            style="
              width: 88px;
              height: 88px;
              border-radius: 50%;
              background: #0d6efd1a;
              font-size: 34px;
              color: #0d6efd;
            "
          >
            <i class="fa-solid fa-user"></i>
          </div>
          <h3 class="mb-1"><%= user.name %></h3>
          <span class="badge bg-success mb-2"><%= user.role %></span>
          <div class="fs-3 fw-bold text-primary mt-2">
            <%= rewards.points %>
            <span class="fs-6 text-muted fw-normal">points</span>
          </div>
        </div>
      </div>

      <!-- DETAILS CARD -->
      <div class="card shadow mb-4">
        <div class="card-body p-4">
          <h5 class="mb-3">Account Details</h5>

          <table class="table table-borderless mb-0">
            <tr>
              <td class="text-muted" style="width: 45%">
                <i class="fa-solid fa-envelope me-2"></i>Email
              </td>
              <td><%= user.email %></td>
            </tr>
            <tr>
              <td class="text-muted">
                <i class="fa-solid fa-user-tag me-2"></i>Role
              </td>
              <td><%= user.role %></td>
            </tr>
            <tr>
              <td class="text-muted">
                <i class="fa-solid fa-bicycle me-2"></i>Total Rides
              </td>
              <td><%= rewards.rides %></td>
            </tr>
            <tr>
              <td class="text-muted">
                <i class="fa-regular fa-clock me-2"></i>Total Time
              </td>
              <td>
                <%= Math.floor(rewards.totalMinutes / 60) %>h <%=
                rewards.totalMinutes % 60 %>m
              </td>
            </tr>
            <tr>
              <td class="text-muted">
                <i class="fa-solid fa-gift me-2"></i>Free Hours
              </td>
              <td><%= rewards.freeHours %></td>
            </tr>
          </table>
        </div>
      </div>

      <!-- REFERRAL CARD -->
      <div class="card shadow mb-4">
        <div class="card-body p-4">
          <h5 class="mb-3">Referral</h5>

          <table class="table table-borderless mb-3">
            <tr>
              <td class="text-muted" style="width: 45%">
                <i class="fa-solid fa-tag me-2"></i>Your Code
              </td>
              <td>
                <strong
                  id="profileReferralCode"
                  style="
                    font-family: 'Courier New', monospace;
                    letter-spacing: 1px;
                  "
                >
                  <%= rewards.referralCode %>
                </strong>
              </td>
            </tr>
            <tr>
              <td class="text-muted">
                <i class="fa-solid fa-user-group me-2"></i>Friends Referred
              </td>
              <td><%= rewards.friendsReferred %></td>
            </tr>
            <tr>
              <td class="text-muted">
                <i class="fa-solid fa-key me-2"></i>Referred By
              </td>
              <td><%= rewards.referredBy || "None" %></td>
            </tr>
          </table>

          <div class="d-flex gap-2">
            <button
              onclick="copyProfileCode()"
              class="btn btn-outline-primary btn-sm"
            >
              <i class="fa-solid fa-copy"></i> Copy Referral Code
            </button>
            <a href="/rewards" class="btn btn-warning btn-sm fw-bold">
              <i class="fa-solid fa-star"></i> Go to Rewards
            </a>
          </div>
        </div>
      </div>
    </div>

    <footer class="bg-primary text-white mt-5">
      <div class="container text-center p-4">
        <h4>CityScoot Bicycle Rental</h4>

        <p>Ride Smart &bull; Ride Safe &bull; Ride Green</p>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
      function copyProfileCode() {
        const code = document
          .getElementById('profileReferralCode')
          .textContent.trim();
        navigator.clipboard.writeText(code);
        alert('Referral code copied!');
      }
    </script>
  </body>
</html>
