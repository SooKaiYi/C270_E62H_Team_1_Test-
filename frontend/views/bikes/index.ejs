<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title><%= title %></title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/styles/home.css" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>

  <body>
    <!-- ================= NAVBAR ================= -->

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
      <div class="container">
        <a class="navbar-brand fw-bold fs-3" href="/home"> 🚲 CityScoot </a>

        <button
          class="navbar-toggler"
          data-bs-toggle="collapse"
          data-bs-target="#navbar"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbar">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <a class="nav-link" href="/home"> Home </a>
            </li>

            <li class="nav-item">
              <a class="nav-link active" href="/bikes"> Bikes </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/map"> Map </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/wallet"> Wallet </a>
            </li>
          </ul>

          <!-- User -->

          <div class="dropdown">
            <button
              class="btn btn-light dropdown-toggle"
              data-bs-toggle="dropdown"
            >
              <i class="fa-solid fa-user"></i>

              <%= user.name %>
            </button>

            <ul class="dropdown-menu dropdown-menu-end">
              <li class="dropdown-header">
                <strong><%= user.name %></strong>

                <br />

                <small><%= user.email %></small>
              </li>

              <li>
                <hr class="dropdown-divider" />
              </li>

              <li>
                <a class="dropdown-item" href="/wallet"> Wallet </a>
              </li>

              <li>
                <a class="dropdown-item" href="/logout"> Logout </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </nav>

    <!-- ================= HEADER ================= -->

    <div class="container mt-5">
      <div class="text-center mb-5">
        <h1 class="fw-bold">Available Bikes</h1>

        <p class="text-muted">Choose your preferred bike and rent instantly.</p>
      </div>

      <div class="row g-4">
        <% bikes.forEach(bike => { %>

        <div class="col-lg-3 col-md-6">
          <div class="card shadow h-100">
            <img
              src="<%= bike.image %>"
              class="card-img-top"
              style="height: 220px; object-fit: cover"
            />

            <div class="card-body d-flex flex-column">
              <h4><%= bike.name %></h4>

              <p class="text-muted"><%= bike.description %></p>

              <h5 class="text-success">$<%= bike.price %> per rental</h5>

              <% if(bike.status==="Available"){ %>

              <span class="badge bg-success mb-3"> Available </span>

              <% } else { %>

              <span class="badge bg-danger mb-3"> Rented </span>

              <% } %>

              <div class="mt-auto">
                <% if(bike.status==="Available"){ %>

                <form action="/rentals/rent/<%= bike.id %>" method="POST">
                  <button class="btn btn-primary w-100">
                    <i class="fa-solid fa-bicycle"></i>

                    Rent Bike
                  </button>
                </form>

                <% } else { %>

                <button class="btn btn-secondary w-100" disabled>
                  Unavailable
                </button>

                <% } %>
              </div>
            </div>
          </div>
        </div>

        <% }) %>
      </div>
    </div>

    <footer class="bg-primary text-white mt-5">
      <div class="container text-center p-4">
        <h4>CityScoot Bicycle Rental</h4>

        <p>Ride Smart • Ride Safe • Ride Green</p>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
