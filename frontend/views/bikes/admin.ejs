<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title><%= title %></title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/styles/home.css" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>

  <body>
    <!-- ================= NAVBAR ================= -->

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
      <div class="container">
        <a class="navbar-brand fw-bold fs-3" href="/home"> 🚲 CityScoot </a>

        <button
          class="navbar-toggler"
          data-bs-toggle="collapse"
          data-bs-target="#navbar"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbar">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <a class="nav-link" href="/home">Home</a>
            </li>

            <li class="nav-item">
              <a class="nav-link active" href="/bikes/admin"> Manage Bikes </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/wallet/admin"> Wallet </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/admin/dashboard"> Dashboard </a>
            </li>
          </ul>

          <a href="/logout" class="btn btn-light"> Logout </a>
        </div>
      </div>
    </nav>

    <!-- ================= CONTENT ================= -->

    <div class="container mt-5">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
          <i class="fa-solid fa-bicycle"></i>

          Bike Management
        </h2>

        <a href="/bikes/add" class="btn btn-success">
          <i class="fa-solid fa-plus"></i>

          Add Bike
        </a>
      </div>

      <table class="table table-bordered table-hover shadow">
        <thead class="table-primary">
          <tr>
            <th>ID</th>
            <th>Image</th>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Status</th>
            <th width="220">Actions</th>
          </tr>
        </thead>

        <tbody>
          <% bikes.forEach(bike => { %>

          <tr>
            <td><%= bike.id %></td>

            <td>
              <img src="<%= bike.image %>" width="100" class="rounded" />
            </td>

            <td><%= bike.name %></td>

            <td><%= bike.description %></td>

            <td>$<%= bike.price %></td>

            <td>
              <% if(bike.status==="Available"){ %>

              <span class="badge bg-success"> Available </span>

              <% } else { %>

              <span class="badge bg-danger"> Rented </span>

              <% } %>
            </td>

            <td>
              <a
                href="/bikes/edit/<%= bike.id %>"
                class="btn btn-warning btn-sm"
              >
                Edit
              </a>

              <form
                action="/bikes/delete/<%= bike.id %>"
                method="POST"
                style="display: inline"
              >
                <button
                  class="btn btn-danger btn-sm"
                  onclick="return confirm('Delete this bike?');"
                >
                  Delete
                </button>
              </form>
            </td>
          </tr>

          <% }) %>
        </tbody>
      </table>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
