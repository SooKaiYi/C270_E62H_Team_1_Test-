<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Rewards - CityScoot</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/styles/home.css" />

    <link rel="stylesheet" href="/styles/rewards.css" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>

  <body>
    <!-- ================= NAVBAR ================= -->

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
      <div class="container">
        <a class="navbar-brand fw-bold fs-3" href="/"> 🚲 CityScoot </a>

        <button
          class="navbar-toggler"
          data-bs-toggle="collapse"
          data-bs-target="#navbar"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbar">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <a class="nav-link" href="/home">Home</a>
            </li>

            <li class="nav-item">
              <a
                class="nav-link"
                href="/bikes"
                title="Available bicycles and prices"
              >
                Bikes
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/map" title="Track your ride distance">
                Map
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/wallet" title="Manage your wallet">
                Wallet
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/rentals" title="View rental history">
                Rentals
              </a>
            </li>

            <li class="nav-item">
              <a
                class="nav-link active"
                href="/rewards"
                title="Points, referrals and redemptions"
              >
                Rewards
              </a>
            </li>
          </ul>

          <!-- PROFILE -->

          <div class="dropdown">
            <button
              class="btn btn-light dropdown-toggle"
              type="button"
              data-bs-toggle="dropdown"
            >
              <i class="fa-solid fa-user"></i>

              <%= user.name %>
            </button>

            <ul
              class="dropdown-menu dropdown-menu-end p-3"
              style="width: 250px"
            >
              <a href="/profile" class="text-decoration-none text-dark">
                <h5 class="mb-0"><%= user.name %></h5>
              </a>

              <p class="text-muted mb-1"><%= user.email %></p>

              <span class="badge bg-success mb-3"> <%= user.role %> </span>

              <hr />

              <a class="dropdown-item" href="/profile">
                <i class="fa-solid fa-id-badge"></i>
                Profile
              </a>

              <a class="dropdown-item" href="/wallet">
                <i class="fa-solid fa-wallet"></i>
                Wallet
              </a>

              <a class="dropdown-item" href="/rewards">
                <i class="fa-solid fa-star"></i>
                Rewards
              </a>

              <a class="dropdown-item" href="#">
                <i class="fa-solid fa-clock-rotate-left"></i>
                Rental History
              </a>

              <% if(user.role=="Admin"){ %>

              <hr />

              <a class="dropdown-item" href="/admin/dashboard">
                <i class="fa-solid fa-user-shield"></i>

                Admin Dashboard
              </a>

              <% } %>

              <hr />

              <a class="dropdown-item" href="/logout"> Logout </a>
            </ul>
          </div>
        </div>
      </div>
    </nav>

    <!-- ================= REWARDS CONTENT ================= -->

    <div class="container mt-5 mb-5">
      <h1 class="mb-1">Rewards</h1>
      <p class="text-muted">Ride more, earn more points automatically</p>

      <!-- BALANCE CARD -->
      <div class="card shadow bg-primary text-white mb-4">
        <div class="card-body p-4">
          <div class="text-center mb-4">
            <span class="text-uppercase small opacity-75">Your Points</span>
            <div class="display-4 fw-bold" id="pointsDisplay">
              <%= rewards.points %>
            </div>
          </div>

          <div class="mb-4">
            <div
              class="progress"
              style="height: 10px; background: rgba(255, 255, 255, 0.2)"
            >
              <div
                class="progress-bar bg-warning"
                id="progressFill"
                style="width: <%= progress %>%"
              ></div>
            </div>
            <div class="text-center small mt-2 opacity-75" id="progressText">
              <%= rewards.points %> / <%= nextReward %> pts to Free 1 Hour
            </div>
          </div>

          <div class="row text-center">
            <div class="col-4">
              <div class="fs-4 fw-bold" id="statFreeHours">
                <%= rewards.freeHours %>
              </div>
              <div class="small opacity-75 text-uppercase">Free Hours</div>
            </div>
            <div class="col-4">
              <div class="fs-4 fw-bold" id="statRides">
                <%= rewards.rides %>
              </div>
              <div class="small opacity-75 text-uppercase">Rides</div>
            </div>
            <div class="col-4">
              <div class="fs-4 fw-bold" id="statTotalTime">
                <%= Math.floor(rewards.totalMinutes / 60) %>h <%=
                rewards.totalMinutes % 60 %>m
              </div>
              <div class="small opacity-75 text-uppercase">Total Time</div>
            </div>
          </div>
        </div>
      </div>

      <!-- REFERRAL CARD -->
      <div class="card shadow mb-4">
        <div class="card-body p-4">
          <h4>
            <i class="fa-solid fa-user-group text-primary"></i> Refer a Friend
          </h4>

          <div
            class="referral-code-box d-flex align-items-center justify-content-between flex-wrap gap-2 my-3"
          >
            <span
              >Your Code:
              <strong id="referralCode"
                ><%= rewards.referralCode %></strong
              ></span
            >
            <button onclick="copyCode()" class="btn btn-sm btn-outline-primary">
              <i class="fa-solid fa-copy"></i> Copy
            </button>
          </div>

          <p class="text-muted mb-3">
            🎁 First friend: <strong>20 points</strong> &nbsp;|&nbsp; 🎁 Each
            friend after: <strong>5 points</strong>
          </p>

          <hr />

          <p>
            Enter a friend's referral code to get
            <strong>5 bonus points</strong>:
          </p>

          <% if (rewards.referredBy) { %>
          <p class="text-success fw-bold">
            ✅ You already used a referral code:
            <strong><%= rewards.referredBy %></strong>
          </p>
          <% } else { %>
          <div class="input-group" style="max-width: 400px">
            <input
              type="text"
              id="friendCode"
              class="form-control"
              placeholder="Enter code..."
            />
            <button class="btn btn-warning fw-bold" onclick="submitReferral()">
              Redeem
            </button>
          </div>
          <div id="referralResult" class="mt-2"></div>
          <% } %>
        </div>
      </div>

      <!-- RIDE SIMULATOR -->
      <div class="card shadow mb-4">
        <div class="card-body p-4">
          <h4>
            <i class="fa-solid fa-flask text-primary"></i> Test Ride Points
          </h4>
          <p class="text-muted small">
            (This simulates what happens when tracking ends)
          </p>

          <div class="input-group" style="max-width: 400px">
            <input
              type="number"
              id="minutesInput"
              class="form-control"
              placeholder="Enter ride minutes..."
              step="0.1"
              min="1"
              max="300"
            />
            <button class="btn btn-primary" onclick="calculateRide()">
              Calculate
            </button>
          </div>

          <div id="calculationResultBox" class="mt-3"></div>
        </div>
      </div>

      <!-- REDEEM REWARDS -->
      <div class="card shadow mb-4">
        <div class="card-body p-4">
          <h4><i class="fa-solid fa-gift text-primary"></i> Redeem Rewards</h4>

          <div class="row g-3 mt-2">
            <div class="col-md-4">
              <div class="card h-100 text-center p-3 reward-card">
                <i class="fa-regular fa-clock fa-2x text-primary"></i>
                <h5 class="mt-2">Free 30 Min</h5>
                <p class="text-muted">25 points</p>
                <button class="btn btn-primary" onclick="redeem(25)">
                  Redeem
                </button>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card h-100 text-center p-3 reward-card highlight">
                <i class="fa-solid fa-clock fa-2x text-warning"></i>
                <h5 class="mt-2">Free 1 Hour</h5>
                <p class="text-muted">50 points</p>
                <button class="btn btn-warning fw-bold" onclick="redeem(50)">
                  Redeem
                </button>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card h-100 text-center p-3 reward-card">
                <i class="fa-solid fa-business-time fa-2x text-primary"></i>
                <h5 class="mt-2">Free 2 Hours</h5>
                <p class="text-muted">100 points</p>
                <button class="btn btn-primary" onclick="redeem(100)">
                  Redeem
                </button>
              </div>
            </div>
          </div>

          <div id="redeemMessage" class="mt-3"></div>
        </div>
      </div>

      <!-- TRANSACTION HISTORY -->
      <div class="card shadow">
        <div class="card-body p-4">
          <h4>
            <i class="fa-solid fa-receipt text-primary"></i> Recent Activity
          </h4>

          <div class="transaction-list mt-3" id="transactionList">
            <% if (transactions.length === 0) { %>
            <p class="text-muted">
              No activity yet. Take a ride to start earning points!
            </p>
            <% } %> <% transactions.forEach(function(txn) { %>
            <div
              class="transaction d-flex align-items-center gap-3 py-2 border-bottom"
            >
              <span><%= txn.type === 'earned' ? '➕' : '➖' %></span>
              <span class="flex-grow-1"><%= txn.desc %></span>
              <span class="text-muted small"><%= txn.date %></span>
              <span
                class="fw-bold <%= txn.type === 'earned' ? 'text-success' : 'text-danger' %>"
              >
                <%= txn.type === 'earned' ? '+' : '-' %><%= txn.points %>
              </span>
            </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>

    <footer class="bg-primary text-white mt-5">
      <div class="container text-center p-4">
        <h4>CityScoot Bicycle Rental</h4>

        <p>Ride Smart • Ride Safe • Ride Green</p>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="/src/rewards.js"></script>
  </body>
</html>
