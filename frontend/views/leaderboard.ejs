<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/home.css" />
    <title>CityScoot - Leaderboard</title>
  </head>
  <body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
      <div class="container">
        <a class="navbar-brand fw-bold fs-3" href="/home">🚲 CityScoot</a>
        <div class="collapse navbar-collapse">
          <ul class="navbar-nav me-auto">
            <li class="nav-item"><a class="nav-link" href="/home">Home</a></li>
            <li class="nav-item">
              <a class="nav-link" href="/bikes">Bikes</a>
            </li>
            <li class="nav-item"><a class="nav-link" href="/map">Map</a></li>
            <li class="nav-item">
              <a class="nav-link" href="/wallet">Wallet</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/tracker">Tracker</a>
            </li>
            <li class="nav-item">
              <a class="nav-link active" href="/leaderboard">Leaderboard</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <main class="container py-4">
      <div class="card shadow-sm p-4">
        <div
          class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4"
        >
          <div>
            <p class="text-uppercase text-muted mb-1">Distance Tracker</p>
            <h2 class="mb-1">Ride Leaderboard</h2>
            <p class="text-muted mb-0">
              Compare your progress with the wider community or just your
              circle.
            </p>
          </div>
          <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" href="/home">Back to Home</a>
            <a class="btn btn-primary" href="/tracker">Open Tracker</a>
          </div>
        </div>

        <div class="row g-4">
          <section class="col-lg-6">
            <div class="border rounded p-3 h-100">
              <h4 class="mb-3">🌍 Global leaderboard</h4>
              <ol class="list-group list-group-numbered">
                <% leaderboard.global.forEach((entry, index) => { %>
                <li
                  class="list-group-item d-flex justify-content-between align-items-start <%= entry.name === user.name ? 'list-group-item-warning' : '' %>"
                >
                  <div class="ms-2 me-auto">
                    <div class="fw-bold"><%= entry.name %></div>
                    <div class="text-muted small"><%= entry.city %></div>
                  </div>
                  <span class="badge bg-primary rounded-pill"
                    ><%= entry.distance.toFixed(1) %> km</span
                  >
                </li>
                <% }) %>
              </ol>
            </div>
          </section>

          <section class="col-lg-6">
            <div class="border rounded p-3 h-100">
              <h4 class="mb-3">👥 Friends leaderboard</h4>
              <ol class="list-group list-group-numbered">
                <% leaderboard.friends.forEach((entry, index) => { %>
                <li
                  class="list-group-item d-flex justify-content-between align-items-start <%= entry.name === user.name ? 'list-group-item-warning' : '' %>"
                >
                  <div class="ms-2 me-auto">
                    <div class="fw-bold"><%= entry.name %></div>
                    <div class="text-muted small"><%= entry.city %></div>
                  </div>
                  <span class="badge bg-success rounded-pill"
                    ><%= entry.distance.toFixed(1) %> km</span
                  >
                </li>
                <% }) %>
              </ol>
            </div>
          </section>
        </div>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
