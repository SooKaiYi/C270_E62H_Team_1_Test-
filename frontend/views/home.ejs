<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>CityScoot Bicycle Rental</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="/styles/home.css">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

</head>

<body>

<!-- ================= NAVBAR ================= -->

<nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">

<div class="container">

<a class="navbar-brand fw-bold fs-3" href="/">
🚲 CityScoot
</a>

<button class="navbar-toggler"
data-bs-toggle="collapse"
data-bs-target="#navbar">

<span class="navbar-toggler-icon"></span>

</button>

<div class="collapse navbar-collapse" id="navbar">

<ul class="navbar-nav me-auto">

<li class="nav-item">
<a class="nav-link active" href="/">Home</a>
</li>

<li class="nav-item">
    <a class="nav-link" href="/bikes" title="Available bicycles and prices">
        Bikes
    </a>
</li>

<li class="nav-item">
<a class="nav-link" href="/map" title="Track your ride distance">
Map
</a>
</li>

<li class="nav-item">
<a class="nav-link" href="/wallet" title="Manage your wallet">
Wallet
</a>
</li>

<li class="nav-item">
<a class="nav-link" href="/rentals" title="View rental history">
Rentals
</a>
</li>

</ul>

<!-- PROFILE -->

<div class="dropdown">

<button class="btn btn-light dropdown-toggle"
type="button"
data-bs-toggle="dropdown">

<i class="fa-solid fa-user"></i>

<%= user.name %>

</button>

<ul class="dropdown-menu dropdown-menu-end p-3" style="width:250px;">

<h5><%= user.name %></h5>

<p class="text-muted mb-1">

<%= user.email %>

</p>

<span class="badge bg-success mb-3">

<%= user.role %>

</span>

<hr>

<a class="dropdown-item" href="/wallet">
<i class="fa-solid fa-wallet"></i>
Wallet
</a>

<a class="dropdown-item" href="#">
<i class="fa-solid fa-map-location-dot"></i>
Distance Tracker
</a>

<a class="dropdown-item" href="#">
<i class="fa-solid fa-clock-rotate-left"></i>
Rental History
</a>

<% if(user.role=="Admin"){ %>

<hr>

<a class="dropdown-item" href="/admin/dashboard">
<i class="fa-solid fa-user-shield"></i>

Admin Dashboard

</a>

<% } %>

<hr>

<a class="dropdown-item" href="/logout">

Logout

</a>

</ul>

</div>

</div>

</div>

</nav>

<!-- HERO -->

<section class="hero">

<div class="overlay">

<div class="container text-center text-white">

<h1 class="display-2 fw-bold">

Explore Singapore

</h1>

<h3>

Ride Anywhere With CityScoot

</h3>

<p>

Affordable Bicycle Rentals Around Marina Bay

</p>

<a href="/bikes" class="btn btn-warning btn-lg">
    Rent Now
</a>

</div>

</div>

</section>

<!-- FEATURE BUTTONS -->

<div class="container mt-5">

<div class="row g-4">

<div class="col-md-3">

<div class="card shadow h-100 text-center p-4">

<i class="fa-solid fa-bicycle fa-3x text-primary"></i>

<h4 class="mt-3">

Bicycles

</h4>

<p>

View available bicycles and rental prices.

</p>

</div>

</div>

<div class="col-md-3">

<a href="/wallet" class="text-decoration-none text-dark">

<div class="card shadow h-100 text-center p-4">

<i class="fa-solid fa-wallet fa-3x text-success"></i>

<h4 class="mt-3">

Wallet

</h4>

<p>

Top up and manage your account balance.

</p>

</div>

</a>

</div>

<div class="col-md-3">

<div class="card shadow h-100 text-center p-4">

<i class="fa-solid fa-map-location-dot fa-3x text-danger"></i>

<h4 class="mt-3">

Distance Tracker

</h4>

<p>

Track cycling routes and total distance.

</p>

</div>

</div>

<div class="col-md-3">

<div class="card shadow h-100 text-center p-4">

<i class="fa-solid fa-tags fa-3x text-warning"></i>

<h4 class="mt-3">

Promotions

</h4>

<p>

View latest discounts and events.

</p>

</div>

</div>

</div>

</div>

<!-- POPULAR BIKES -->

<div class="container mt-5">

<h2 class="text-center mb-4">

Popular Bicycle Rentals

</h2>

<div class="row g-4">

<div class="col-md-3">

<div class="card shadow">

<img src="https://images.unsplash.com/photo-1541625602330-2277a4c46182?auto=format&fit=crop&w=700&q=80"
class="card-img-top">

<div class="card-body">

<h5>Road Bike</h5>

<p>$12 Per Rental</p>

</div>

</div>

</div>

<div class="col-md-3">

<div class="card shadow">

<img src="https://images.unsplash.com/photo-1511994298241-608e28f14fde?auto=format&fit=crop&w=700&q=80"
class="card-img-top">

<div class="card-body">

<h5>Mountain Bike</h5>

<p>$8 Per Rental</p>

</div>

</div>

</div>

<div class="col-md-3">

<div class="card shadow">

<img src="https://img.magnific.com/free-photo/electric-bike-battery-motor-wheel-with-pedal-rear-shock-absorber_114579-347.jpg?semt=ais_hybrid&w=740&q=80"
class="card-img-top">

<div class="card-body">

<h5>Electric Bike</h5>

<p>$15 Per Rental</p>

</div>

</div>

</div>

<div class="col-md-3">

<div class="card shadow">

<img src="https://images.unsplash.com/photo-1485965120184-e220f721d03e?auto=format&fit=crop&w=700&q=80"
class="card-img-top">

<div class="card-body">

<h5>Normal Bike</h5>

<p>$4 Per Rental</p>

</div>

</div>

</div>

</div>

</div>

<footer class="bg-primary text-white mt-5">

<div class="container text-center p-4">

<h4>

CityScoot Bicycle Rental

</h4>

<p>

Ride Smart • Ride Safe • Ride Green

</p>

</div>

</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>