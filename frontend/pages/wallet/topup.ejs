<%- include('../partials/header') %>
<link rel="stylesheet" href="/styles/wallet.css">

<section class="page-heading text-center">
    <h1 class="fw-bold">Top Up Credits</h1>
    <p class="mb-0">Add money into your bike wallet before renting a bicycle.</p>
</section>

<section class="form-card">
    <div class="text-center mb-4">
        <div class="balance-icon mx-auto">💰</div>
        <h2 class="h4 fw-bold mb-1">Choose an Amount</h2>
        <p class="text-muted mb-0">Your credits will be available immediately after top up.</p>
    </div>

    <form action="/wallet/topup" method="POST" data-validate-topup>
        <div class="quick-amounts">
            <button type="button" class="btn btn-outline-primary" data-amount="5">$5</button>
            <button type="button" class="btn btn-outline-primary" data-amount="10">$10</button>
            <button type="button" class="btn btn-outline-primary" data-amount="20">$20</button>
            <button type="button" class="btn btn-outline-primary" data-amount="50">$50</button>
        </div>

        <div class="mb-3">
            <label for="amount" class="form-label fw-semibold">Custom top-up amount</label>
            <div class="input-group input-group-lg">
                <span class="input-group-text">$</span>
                <input type="number" class="form-control" id="amount" name="amount" min="0.01" step="0.01" placeholder="10.00" required>
            </div>
            <div class="form-text">Amount must be more than $0.</div>
        </div>
        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-bike">Add Credits</button>
            <a href="/wallet" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</section>

<script src="/src/wallet.js"></script>
<%- include('../partials/footer') %>
