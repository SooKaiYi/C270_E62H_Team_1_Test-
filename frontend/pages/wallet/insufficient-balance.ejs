<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Insufficient Balance</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="container mt-5">
      <div class="card shadow p-4 text-center">
        <h1 class="text-danger">Insufficient Balance</h1>

        <p class="mt-3">
          You do not have enough wallet balance to rent this bike.
        </p>

        <hr />

        <div class="row">
          <div class="col">
            <h5>Current Balance</h5>
            <p class="fs-4 text-primary">$<%= balance %></p>
          </div>

          <div class="col">
            <h5>Required Amount</h5>
            <p class="fs-4 text-danger">$<%= required %></p>
          </div>
        </div>

        <div class="mt-4">
          <a href="/wallet" class="btn btn-success"> Top Up Wallet </a>

          <a href="/rentals" class="btn btn-secondary"> Back to Rentals </a>
        </div>
      </div>
    </div>
  </body>
</html>
