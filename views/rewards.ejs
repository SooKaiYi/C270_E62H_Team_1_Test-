<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rewards - CycleApp</title>
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
    <div class="container">

        <!-- HEADER -->
        <header>
            <h1>⭐ Rewards</h1>
            <p>Welcome back, <strong><%= user.name %></strong>!</p>
            <p class="subtitle">Ride more, earn more points automatically</p>
        </header>

        <!-- BALANCE CARD -->
        <div class="balance-card">
            <div class="balance">
                <span class="label">Your Points</span>
                <span class="amount" id="pointsDisplay"><%= user.points %></span>
            </div>
            
            <div class="progress-section">
                <div class="progress-bar">
                    <div class="progress-fill" style="width: <%= progress %>%;"></div>
                </div>
                <span class="progress-text">
                    <%= user.points %> / <%= nextReward %> pts to Free 1 Hour
                </span>
            </div>

            <div class="stats">
                <div class="stat">
                    <span class="stat-value"><%= user.freeHours %></span>
                    <span class="stat-label">Free Hours</span>
                </div>
                <div class="stat">
                    <span class="stat-value"><%= user.rides %></span>
                    <span class="stat-label">Rides</span>
                </div>
                <div class="stat">
                    <span class="stat-value"><%= Math.floor(user.totalMinutes / 60) %>h <%= user.totalMinutes % 60 %>m</span>
                    <span class="stat-label">Total Time</span>
                </div>
            </div>
        </div>

        <!-- RIDE SIMULATOR (For Testing) -->
        <div class="calculator">
            <h2>🧪 Test Ride Points</h2>
            <p class="note">(This simulates what happens when tracking ends)</p>
            <form action="/calculate" method="POST">
                <div class="input-group">
                    <input 
                        type="number" 
                        name="minutes" 
                        placeholder="Enter ride minutes..." 
                        step="0.1"
                        min="1" 
                        max="300" 
                        required
                    />
                    <button type="submit">Calculate</button>
                </div>
            </form>

            <% if (typeof pointsEarned !== 'undefined' && pointsEarned !== null) { %>
                <div class="result <%= pointsEarned > 0 ? 'success' : 'warning' %>">
                    <% if (pointsEarned > 0) { %>
                        ✅ <strong><%= rideMinutes %> min</strong> → rounded down to <strong><%= calculationResult.roundedMinutes %> min</strong> → <strong><%= pointsEarned %> points</strong>
                        <% if (calculationResult.roundedMinutes >= 60) { %>
                            <br>⭐ Bonus: 15 points minimum for 1h+ rides applied!
                        <% } %>
                        <br><small>This would be added to your balance automatically</small>
                    <% } else { %>
                        ⚠️ <strong><%= rideMinutes %> min</strong> → rounded down to <strong><%= calculationResult.roundedMinutes %> min</strong> → <strong>0 points</strong>
                        <br><small>Rides under 10 minutes earn no points</small>
                    <% } %>
                </div>
            <% } %>
        </div>

        <!-- REWARDS REDEMPTION -->
        <div class="rewards-section">
            <h2>🎁 Redeem Rewards</h2>
            <div class="reward-grid">
                <div class="reward-card">
                    <span class="icon">⏰</span>
                    <h3>Free 30 Min</h3>
                    <p>25 points</p>
                    <button onclick="redeem(25)">Redeem</button>
                </div>
                <div class="reward-card highlight">
                    <span class="icon">🕐</span>
                    <h3>Free 1 Hour</h3>
                    <p>50 points</p>
                    <button onclick="redeem(50)">Redeem</button>
                </div>
                <div class="reward-card">
                    <span class="icon">🕑</span>
                    <h3>Free 2 Hours</h3>
                    <p>100 points</p>
                    <button onclick="redeem(100)">Redeem</button>
                </div>
            </div>
            <div id="redeemMessage" class="redeem-message"></div>
        </div>

        <!-- TRANSACTION HISTORY -->
        <div class="history">
            <h2>📜 Recent Activity</h2>
            <div class="transaction-list">
                <% transactions.forEach(function(txn) { %>
                    <div class="transaction <%= txn.type %>">
                        <span class="icon"><%= txn.type === 'earned' ? '➕' : '➖' %></span>
                        <span class="desc"><%= txn.desc %></span>
                        <span class="date"><%= txn.date %></span>
                        <span class="points <%= txn.type === 'earned' ? 'green' : 'red' %>">
                            <%= txn.type === 'earned' ? '+' : '-' %><%= txn.points %>
                        </span>
                    </div>
                <% }); %>
            </div>
        </div>

        <!-- INTEGRATION INFO -->
        <div class="integration-info">
            <h3>🔌 Tracking Integration</h3>
            <p>When your tracking page ends a ride, send a POST request to:</p>
            <code>POST /api/ride-complete</code>
            <p>With body:</p>
            <code>{ "minutes": 25.8 }</code>
            <p class="note">The system will automatically round down and add points!</p>
        </div>

    </div>

    <script>
        // ========== REDEEM FUNCTION ==========
        async function redeem(points) {
            const rewardNames = {
                25: 'Free 30 Minutes',
                50: 'Free 1 Hour',
                100: 'Free 2 Hours'
            };
            
            const confirmMsg = `Redeem ${points} points for ${rewardNames[points] || 'reward'}?`;
            if (!confirm(confirmMsg)) return;

            try {
                const response = await fetch('/api/redeem', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ points: points })
                });

                const data = await response.json();
                const msgDiv = document.getElementById('redeemMessage');
                
                if (data.success) {
                    msgDiv.className = 'redeem-message success';
                    msgDiv.innerHTML = `✅ ${data.message}`;
                    document.getElementById('pointsDisplay').textContent = data.newPoints;
                    // Update progress bar
                    const progress = Math.min((data.newPoints / 50) * 100, 100);
                    document.querySelector('.progress-fill').style.width = progress + '%';
                    document.querySelector('.progress-text').textContent = 
                        `${data.newPoints} / 50 pts to Free 1 Hour`;
                    // Update free hours
                    document.querySelector('.stat-value').textContent = data.freeHours;
                    
                    setTimeout(() => location.reload(), 2000);
                } else {
                    msgDiv.className = 'redeem-message error';
                    msgDiv.innerHTML = `❌ ${data.message}`;
                }
            } catch (error) {
                const msgDiv = document.getElementById('redeemMessage');
                msgDiv.className = 'redeem-message error';
                msgDiv.innerHTML = '❌ Something went wrong. Please try again.';
            }
        }
    </script>
</body>
</html>