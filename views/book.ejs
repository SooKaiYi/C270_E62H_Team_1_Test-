<%- include('partials/header', { title: 'Book ' + vehicle.name }) %>

<h1>Book: <%= vehicle.name %></h1>
<p class="rate">Rate: $<%= vehicle.ratePerHour.toFixed(2) %> / hour</p>

<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<form method="POST" action="/book/<%= vehicle.id %>" id="bookingForm">
  <label for="customerName">Your Name</label>
  <input type="text" id="customerName" name="customerName" value="<%= form.customerName || '' %>" required />

  <label for="startTime">Start Time</label>
  <input type="datetime-local" id="startTime" name="startTime" value="<%= form.startTime || '' %>" required />

  <label for="endTime">End Time</label>
  <input type="datetime-local" id="endTime" name="endTime" value="<%= form.endTime || '' %>" required />

  <div id="priceBox" class="price-box" style="display:none;">
    <p>Duration: <span id="durationText"></span></p>
    <p>Billable Hours: <span id="billableHoursText"></span></p>
    <p class="price-total">Total: $<span id="priceText"></span></p>
  </div>
  <div id="priceError" class="alert alert-error" style="display:none;"></div>

  <button type="submit" class="btn">Confirm Booking</button>
</form>

<script>
  const ratePerHour = <%= vehicle.ratePerHour %>;
  const startInput = document.getElementById('startTime');
  const endInput = document.getElementById('endTime');
  const priceBox = document.getElementById('priceBox');
  const priceError = document.getElementById('priceError');

  async function updatePrice() {
    const startTime = startInput.value;
    const endTime = endInput.value;
    if (!startTime || !endTime) return;

    try {
      const res = await fetch('/calculate-price', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ratePerHour, startTime, endTime }),
      });
      const data = await res.json();

      if (!res.ok) {
        priceBox.style.display = 'none';
        priceError.style.display = 'block';
        priceError.textContent = data.error;
        return;
      }

      priceError.style.display = 'none';
      priceBox.style.display = 'block';
      document.getElementById('durationText').textContent = data.hours + ' hr(s)';
      document.getElementById('billableHoursText').textContent = data.billableHours;
      document.getElementById('priceText').textContent = data.totalPrice.toFixed(2);
    } catch (err) {
      console.error('Price calculation failed', err);
    }
  }

  startInput.addEventListener('change', updatePrice);
  endInput.addEventListener('change', updatePrice);
</script>

<%- include('partials/footer') %>
